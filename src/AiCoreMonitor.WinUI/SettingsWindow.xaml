<Window x:Class="AiCoreMonitor.WinUI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="#F20A0D14" Loaded="Root_Loaded">
    <Grid.Resources>
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2ADFFF" />
        <GradientStop Color="#7388FF" Offset="0.52" />
        <GradientStop Color="#C15CFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B91A2634" />
        <GradientStop Color="#C00D121C" Offset="0.52" />
        <GradientStop Color="#AA181327" Offset="1" />
      </LinearGradientBrush>
      <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6F8FAE" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="140" />
      </Style>
      <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F2F8FF" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="CardHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7890A8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelGradient}" />
        <Setter Property="BorderBrush" Value="#4A597187" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
      </Style>
      <Style x:Key="SwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="#DDEAF7" />
        <Setter Property="MinWidth" Value="140" />
      </Style>
      <Style x:Key="TitleToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="OnContent" Value="" />
      </Style>
      <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#9FD8EF" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Bahnschrift" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Background="#B4070A10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="46" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="TitleBar" AutomationProperties.AutomationId="SettingsDragRegion" Background="Transparent" Padding="20,0" PointerPressed="TitleBar_PointerPressed">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Grid Width="20" Height="20">
            <Ellipse Fill="#142C3D" Stroke="#4AE2FF" StrokeThickness="1" />
            <Ellipse Width="6" Height="6" Fill="#54E6FF" />
          </Grid>
          <TextBlock Text="AI CORE / SETTINGS" Foreground="#DCEAF7" FontSize="11" FontWeight="SemiBold" CharacterSpacing="110" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="ON TOP" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="TopmostSwitch" AutomationProperties.AutomationId="TopmostSwitch" Style="{StaticResource TitleToggleStyle}" VerticalAlignment="Center" Toggled="TopmostSwitch_Toggled" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="GPU ENHANCEMENTS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="GpuEnhancementsSwitch" AutomationProperties.AutomationId="GpuEnhancementsSwitch" Style="{StaticResource TitleToggleStyle}" VerticalAlignment="Center" Toggled="GpuEnhancementsSwitch_Toggled" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <TabView Grid.Row="1" x:Name="SettingsTabs" AutomationProperties.AutomationId="SettingsTabs" IsAddTabButtonVisible="False" TabWidthMode="Equal" Padding="18,10,18,18">
      <TabViewItem Header="Visual Effects" AutomationProperties.AutomationId="EffectsTab" IsClosable="False">
        <Grid Padding="10,18,10,8" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="EFFECT MATRIX" Foreground="#F3F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="Tune the two procedural surface layers." Foreground="#7890A8" FontSize="12" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel Spacing="12">
                <StackPanel>
                  <TextBlock Text="MOTION ENGINE" Style="{StaticResource SectionLabelStyle}" />
                  <TextBlock Text="Lava flow" Style="{StaticResource CardTitleStyle}" />
                </StackPanel>
                <Border Height="46" CornerRadius="10" Background="#B50D1320" BorderBrush="#455E7690" BorderThickness="1">
                  <Grid>
                    <Ellipse Width="150" Height="50" HorizontalAlignment="Left" Margin="-15,26,0,-28" Fill="#333B8FFF" />
                    <Rectangle Height="2" Margin="18,0" Fill="{StaticResource AccentGradient}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ToggleSwitch x:Name="LavaSwitch" AutomationProperties.AutomationId="LavaSwitch" Header="Enabled" Style="{StaticResource SwitchStyle}" Toggled="LavaSwitch_Toggled" />
                  <ToggleSwitch x:Name="LavaDrippingSwitch" AutomationProperties.AutomationId="LavaDrippingSwitch" Header="Edge drip" Style="{StaticResource SwitchStyle}" Toggled="LavaDrippingSwitch_Toggled" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="LavaAmountLabel" Style="{StaticResource ValueLabelStyle}" />
                  <Slider x:Name="LavaAmountSlider" AutomationProperties.AutomationId="LavaAmountSlider" ValueChanged="LavaAmountSlider_ValueChanged" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="LavaHueLabel" Style="{StaticResource ValueLabelStyle}" />
                <Slider x:Name="LavaHueSlider" AutomationProperties.AutomationId="LavaHueSlider" ValueChanged="LavaHueSlider_ValueChanged" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="LavaVariationLabel" Style="{StaticResource ValueLabelStyle}" />
                  <Slider x:Name="LavaVariationSlider" AutomationProperties.AutomationId="LavaVariationSlider" ValueChanged="LavaVariationSlider_ValueChanged" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
              <StackPanel Spacing="12">
                <StackPanel>
                  <TextBlock Text="LIGHTNING MATRIX" Style="{StaticResource SectionLabelStyle}" />
                  <TextBlock Text="Lightning" Style="{StaticResource CardTitleStyle}" />
                </StackPanel>
                <Border Height="46" CornerRadius="10" Background="#BF0A0F18" BorderBrush="#455E7690" BorderThickness="1">
                  <Grid>
                    <TextBlock Text="/  \/  /\   \  /  \/" Foreground="#D87EA8FF" FontFamily="Consolas" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" CharacterSpacing="90" />
                  </Grid>
                </Border>
                <ToggleSwitch x:Name="CracksSwitch" AutomationProperties.AutomationId="CracksSwitch" Header="Enabled" Style="{StaticResource SwitchStyle}" Toggled="CracksSwitch_Toggled" />
                <StackPanel>
                  <TextBlock x:Name="CrackAmountLabel" Style="{StaticResource ValueLabelStyle}" />
                  <Slider x:Name="CrackAmountSlider" AutomationProperties.AutomationId="CrackAmountSlider" ValueChanged="CrackAmountSlider_ValueChanged" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="CrackHueLabel" Style="{StaticResource ValueLabelStyle}" />
                <Slider x:Name="CrackHueSlider" AutomationProperties.AutomationId="CrackHueSlider" ValueChanged="CrackHueSlider_ValueChanged" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="CrackVariationLabel" Style="{StaticResource ValueLabelStyle}" />
                  <Slider x:Name="CrackVariationSlider" AutomationProperties.AutomationId="CrackVariationSlider" ValueChanged="CrackVariationSlider_ValueChanged" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabViewItem>
      <TabViewItem Header="Voice" AutomationProperties.AutomationId="VoiceTab" IsClosable="False">
        <Grid Padding="10,18,10,8" RowSpacing="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="VOICE ENGINE" Foreground="#F3F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="Connect the monitor to a server running on this machine." Foreground="#7890A8" FontSize="12" />
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="9">
                <FontIcon Glyph="" FontSize="27" Foreground="#55DFFF" HorizontalAlignment="Left" />
                <TextBlock Text="Local voice link" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Text="The endpoint is restricted to loopback. Select the Voice Engine workspace if you want the monitor to start the server." Style="{StaticResource CardHintStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                <TextBox x:Name="VoiceEndpointBox" AutomationProperties.AutomationId="VoiceEndpointBox" Header="LOOPBACK ENDPOINT" PlaceholderText="http://127.0.0.1:8765" LostFocus="VoiceSettings_LostFocus" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="VoiceDirectoryBox" AutomationProperties.AutomationId="VoiceDirectoryBox" Header="SERVER DIRECTORY" PlaceholderText="Choose the Voice Engine workspace" LostFocus="VoiceSettings_LostFocus" />
                  <Button Grid.Column="1" AutomationProperties.AutomationId="BrowseVoiceDirectoryButton" VerticalAlignment="Bottom" Height="32" Padding="15,0" Content="BROWSE" FontSize="10" FontWeight="SemiBold" Click="BrowseVoiceDirectory_Click" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabViewItem>
    </TabView>
  </Grid>
</Window>
