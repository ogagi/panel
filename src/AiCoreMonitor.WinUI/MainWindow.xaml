<Window
    x:Class="AiCoreMonitor.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2ADFFF" Offset="0" />
        <GradientStop Color="#7388FF" Offset="0.52" />
        <GradientStop Color="#C15CFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#791D3145" Offset="0" />
        <GradientStop Color="#56101926" Offset="0.48" />
        <GradientStop Color="#70191A2C" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="ChassisGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#863A4654" Offset="0" />
        <GradientStop Color="#68171E27" Offset="0.13" />
        <GradientStop Color="#520B1018" Offset="0.55" />
        <GradientStop Color="#7522192A" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="DashboardBedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#62070B11" Offset="0" />
        <GradientStop Color="#4F0D121B" Offset="0.18" />
        <GradientStop Color="#35182732" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="ButtonMetalGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9A34404D" Offset="0" />
        <GradientStop Color="#B618202A" Offset="0.45" />
        <GradientStop Color="#CA0A0E14" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="GlassReflectionGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28EAF7FF" Offset="0" />
        <GradientStop Color="#0CD7E8F7" Offset="0.16" />
        <GradientStop Color="#00000000" Offset="0.42" />
        <GradientStop Color="#00000000" Offset="0.74" />
        <GradientStop Color="#0BBA76FF" Offset="1" />
      </LinearGradientBrush>
      <Style x:Key="EyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#91A8BE" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Foreground" Value="#B4C7DD" />
        <Setter Property="Background" Value="{StaticResource ButtonMetalGradient}" />
        <Setter Property="BorderBrush" Value="#405B6A78" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
      <Style x:Key="MenuLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#D2E0EF" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="MenuHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7189A6" />
        <Setter Property="FontSize" Value="9" />
      </Style>
      <Style x:Key="MenuSectionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#7894B5" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
      </Style>
      <Style x:Key="MenuActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#CBE4F8" />
        <Setter Property="Background" Value="#28304250" />
        <Setter Property="BorderBrush" Value="#4D6D8399" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
      </Style>
    </Grid.Resources>

    <Grid x:Name="LavaHost" IsHitTestVisible="False" />

    <!-- Compact mode is a purpose-built telemetry strip, not a scaled dashboard. -->
    <Border x:Name="CompactShell" Margin="1" CornerRadius="14" Background="#D9121923" BorderBrush="#A87D8996" BorderThickness="1" Visibility="Collapsed">
      <Grid>
        <Border Margin="2" CornerRadius="12" Background="{StaticResource ChassisGradient}" />
        <Grid x:Name="CompactTopBar" Margin="12,5" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,7,0" /><TextBlock x:Name="CompactBrandLabel" Text="AI CORE" Foreground="#DCEAF7" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel><TextBlock x:Name="TopRefresh" Text="{Binding LastRefreshText}" Foreground="#536E8D" FontSize="8" Margin="0,4,0,0" Visibility="Collapsed" /></StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CODEX" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="{Binding CodexRemaining}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="TopCodexPlan" Text="{Binding CodexPlan}" Foreground="#7894B5" FontSize="9" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /><TextBlock x:Name="TopCodexReset" Text="{Binding CodexReset}" Foreground="#536E8D" FontSize="8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /></StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><StackPanel><TextBlock Text="GPU" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="{Binding GpuUsage}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold" /></StackPanel><StackPanel><TextBlock Text="VRAM" Style="{StaticResource EyebrowStyle}" /><TextBlock x:Name="TopGpuMemory" Text="{Binding GpuMemory}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed" VerticalAlignment="Center" /></StackPanel></StackPanel><TextBlock x:Name="TopGpuThermals" Text="{Binding GpuThermals}" Foreground="#536E8D" FontSize="8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /></StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="CPU / GPU" Style="{StaticResource EyebrowStyle}" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding CpuUsage}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding RamUsage}" Foreground="#AFC6E2" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="TopCpuDetails" Text="{Binding RamDetails}" Foreground="#7894B5" FontSize="9" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /></StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="MODELS" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="{Binding ModelCount}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="TopModelState" Text="{Binding OllamaState}" Foreground="#49DFB5" FontSize="9" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /><TextBlock x:Name="TopActiveModel" Text="{Binding ActiveModelShort}" Foreground="#536E8D" FontSize="8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /></StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE720;" ToolTipService.ToolTip="Start voice conversation" Click="ConversationButton_Click" /><Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE8A7;" ToolTipService.ToolTip="Switch to side bar" Click="CompactOrientationButton_Click" /><Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE8A5;" ToolTipService.ToolTip="Expand dashboard" Click="ExpandButton_Click" /><Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE8BB;" Click="CloseButton_Click" /></StackPanel>
        </Grid>
        <Grid x:Name="CompactSideBar" Margin="12,10" RowSpacing="8" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid x:Name="CompactSideHeader"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,7,0" /><TextBlock x:Name="SideBrandLabel" Text="AI CORE" Foreground="#DCEAF7" FontSize="10" FontWeight="Bold" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE720;" ToolTipService.ToolTip="Start voice conversation" Click="ConversationButton_Click" /><Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE8A7;" ToolTipService.ToolTip="Switch to top bar" Click="CompactOrientationButton_Click" /><Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE8A5;" ToolTipService.ToolTip="Expand dashboard" Click="ExpandButton_Click" /></StackPanel></Grid>
          <StackPanel Grid.Row="1"><TextBlock Text="CODEX" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="{Binding CodexRemaining}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" /><TextBlock x:Name="SideCodexPlan" Text="{Binding CodexPlan}" Foreground="#7894B5" FontSize="9" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SideCodexReset" Text="{Binding CodexReset}" Foreground="#536E8D" FontSize="8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /></StackPanel>
          <StackPanel Grid.Row="2"><StackPanel Orientation="Horizontal" Spacing="10"><StackPanel><TextBlock Text="GPU" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="{Binding GpuUsage}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" /></StackPanel><StackPanel><TextBlock Text="VRAM" Style="{StaticResource EyebrowStyle}" /><TextBlock x:Name="SideGpuMemory" Text="{Binding GpuMemory}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></StackPanel></StackPanel><TextBlock x:Name="SideGpuThermals" Text="{Binding GpuThermals}" Foreground="#536E8D" FontSize="8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /></StackPanel>
          <StackPanel Grid.Row="3"><TextBlock Text="CPU / GPU" Style="{StaticResource EyebrowStyle}" /><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding CpuUsage}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{Binding RamUsage}" Foreground="#AFC6E2" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="SideCpuDetails" Text="{Binding RamDetails}" Foreground="#7894B5" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Grid.Row="4"><TextBlock Text="MODELS" Style="{StaticResource EyebrowStyle}" /><TextBlock Text="{Binding ModelCount}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" /><TextBlock x:Name="SideModelState" Text="{Binding OllamaState}" Foreground="#49DFB5" FontSize="9" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SideActiveModel" Text="{Binding ActiveModelShort}" Foreground="#536E8D" FontSize="8" TextTrimming="CharacterEllipsis" Visibility="Collapsed" /></StackPanel>
          <TextBlock Grid.Row="5" Text="{Binding LastRefreshText}" Foreground="#536E8D" FontSize="8" HorizontalAlignment="Right" />
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="FullShell" Margin="1" CornerRadius="20" Background="#3105070B" BorderBrush="#B47D8996" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Rear chassis: a dense graphite body with a cool key light and violet rim light. -->
        <Border Grid.RowSpan="2" CornerRadius="19" Background="{StaticResource ChassisGradient}" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Margin="2" CornerRadius="18" BorderThickness="1" BorderBrush="#5EE4F0FA" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Margin="5" CornerRadius="16" BorderThickness="1" BorderBrush="#B006090D" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Margin="6" CornerRadius="15" BorderThickness="1" BorderBrush="#304F5C68" IsHitTestVisible="False" />

        <!-- Directional studio reflection; deliberately localized rather than a glowing outline. -->
        <Border Grid.RowSpan="2" Margin="7" CornerRadius="14" Background="{StaticResource GlassReflectionGradient}" IsHitTestVisible="False" />

        <!-- Machined side rails and mounting points imply a physical enclosure. -->
        <Border Grid.RowSpan="2" Width="3" Margin="7,48,0,18" HorizontalAlignment="Left" CornerRadius="2" Background="#40101820" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Width="1" Margin="8,54,0,24" HorizontalAlignment="Left" Background="#557B8995" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Width="3" Margin="0,48,7,18" HorizontalAlignment="Right" CornerRadius="2" Background="#62090A10" IsHitTestVisible="False" />
        <Ellipse Grid.RowSpan="2" Width="5" Height="5" Margin="9,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#151A21" Stroke="#65717A" StrokeThickness="1" IsHitTestVisible="False" />
        <Ellipse Grid.RowSpan="2" Width="5" Height="5" Margin="0,10,9,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#151A21" Stroke="#65717A" StrokeThickness="1" IsHitTestVisible="False" />

        <Border Grid.Row="0" Margin="8,7,8,0" CornerRadius="12,12,4,4" BorderBrush="#28121A22" BorderThickness="0,0,0,1" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#40384652" Offset="0" />
              <GradientStop Color="#20161E27" Offset="0.45" />
              <GradientStop Color="#68080B10" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <Grid x:Name="DragRegion" Grid.Row="0" Margin="19,0,11,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="18" Height="18" Margin="0,0,10,0">
              <Ellipse Width="17" Height="17" Fill="#07100E" Stroke="#455C6464" StrokeThickness="1" />
              <Ellipse Width="11" Height="11" Fill="#1935F2B4" />
              <Ellipse Width="6" Height="6" Fill="#5EF7C7" />
              <Ellipse Width="2" Height="2" Fill="#E9FFF8" Margin="-2,-2,0,0" />
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="AI / CORE" Foreground="#EDF6FF" FontSize="12" FontWeight="Bold" CharacterSpacing="35" />
              <TextBlock x:Name="HeaderSubtitle" Text="LOCAL TELEMETRY" Foreground="#597391" FontSize="8" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="HeaderActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ConversationButton" Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE720;" FontSize="14" ToolTipService.ToolTip="Start voice conversation" Click="ConversationButton_Click" />
            <Button x:Name="SettingsButton" Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE713;" FontSize="15">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" Opened="SettingsFlyout_Opened">
                  <Border Width="224" Padding="10,8" CornerRadius="10" Background="#FA171324" BorderBrush="#3D7592B4" BorderThickness="1">
                    <StackPanel Spacing="4">
                      <Grid Height="28">
                        <TextBlock Text="KEEP ON TOP" Style="{StaticResource MenuLabelStyle}" VerticalAlignment="Center" />
                        <Button x:Name="TopmostButton" Width="38" HorizontalAlignment="Right" Style="{StaticResource MenuActionButtonStyle}" Click="TopmostButton_Click" />
                      </Grid>

                      <Grid Height="28">
                        <TextBlock Text="GPU VISUALS" Style="{StaticResource MenuLabelStyle}" VerticalAlignment="Center" />
                        <Button x:Name="GpuVisualsButton" Width="38" HorizontalAlignment="Right" Style="{StaticResource MenuActionButtonStyle}" Click="GpuVisualsButton_Click" />
                      </Grid>

                      <Border Height="1" Background="#254B6684" />
                      <TextBlock Text="VOICE SERVER" Style="{StaticResource MenuSectionStyle}" />
                      <TextBox x:Name="VoiceEndpointBox" Header="Loopback endpoint" FontSize="10" LostFocus="VoiceSettings_LostFocus" />
                      <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="VoiceDirectoryBox" Header="Server directory" FontSize="10" LostFocus="VoiceSettings_LostFocus" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="…" Style="{StaticResource MenuActionButtonStyle}" Click="BrowseVoiceDirectory_Click" />
                      </Grid>

                      <Border Height="1" Background="#254B6684" />
                      <TextBlock Text="VISUAL EFFECTS" Style="{StaticResource MenuSectionStyle}" />

                      <Grid Height="28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="26" /><ColumnDefinition Width="22" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                        <TextBlock Text="LAVA FLOW" Style="{StaticResource MenuLabelStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="−" Style="{StaticResource MenuActionButtonStyle}" Click="LavaAmountDown_Click" />
                        <TextBlock x:Name="LavaAmountText" Grid.Column="2" Style="{StaticResource MenuHintStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="+" Style="{StaticResource MenuActionButtonStyle}" Click="LavaAmountUp_Click" />
                        <Button x:Name="LavaButton" Grid.Column="4" Style="{StaticResource MenuActionButtonStyle}" Click="LavaButton_Click" />
                      </Grid>

                      <Grid Height="28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="26" /><ColumnDefinition Width="22" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                        <TextBlock Text="CRACK FIELD" Style="{StaticResource MenuLabelStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="−" Style="{StaticResource MenuActionButtonStyle}" Click="CrackAmountDown_Click" />
                        <TextBlock x:Name="CrackAmountText" Grid.Column="2" Style="{StaticResource MenuHintStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="+" Style="{StaticResource MenuActionButtonStyle}" Click="CrackAmountUp_Click" />
                        <Button x:Name="CracksButton" Grid.Column="4" Style="{StaticResource MenuActionButtonStyle}" Click="CracksButton_Click" />
                      </Grid>

                      <Border Height="1" Background="#254B6684" />
                      <TextBlock Text="COLOR &amp; MOTION" Style="{StaticResource MenuSectionStyle}" />
                      <Grid Height="28" ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions><TextBlock Text="LAVA HUE" Style="{StaticResource MenuSectionStyle}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="−" Style="{StaticResource MenuActionButtonStyle}" Click="LavaHueDown_Click" /><Button Grid.Column="2" Content="+" Style="{StaticResource MenuActionButtonStyle}" Click="LavaHueUp_Click" /></Grid>
                        <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions><TextBlock Text="CRACK HUE" Style="{StaticResource MenuSectionStyle}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="−" Style="{StaticResource MenuActionButtonStyle}" Click="CrackHueDown_Click" /><Button Grid.Column="2" Content="+" Style="{StaticResource MenuActionButtonStyle}" Click="CrackHueUp_Click" /></Grid>
                      </Grid>
                      <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions><TextBlock Text="MOVEMENT" Style="{StaticResource MenuSectionStyle}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="−" Style="{StaticResource MenuActionButtonStyle}" Click="VariationDown_Click" /><Button Grid.Column="2" Content="+" Style="{StaticResource MenuActionButtonStyle}" Click="VariationUp_Click" /></Grid>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE7C3;" FontSize="14" ToolTipService.ToolTip="Compact telemetry bar" Click="CompactButton_Click" />
            <Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE921;" FontSize="12" Click="MinimizeButton_Click" />
            <Button Style="{StaticResource HeaderButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE8BB;" FontSize="14" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="Dashboard" Grid.Row="1" Margin="16,2,16,14" RowSpacing="10" AllowDrop="True" DragOver="Dashboard_DragOver" DragLeave="Dashboard_DragLeave" Drop="Dashboard_Drop">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.08*" />
            <RowDefinition Height="1.08*" />
            <RowDefinition Height="0.95*" />
            <RowDefinition Height="24" />
          </Grid.RowDefinitions>

          <!-- The dashboard bed sits below the chassis face; cards are mounted inside this recess. -->
          <Border Grid.RowSpan="4" Margin="-6,-5,-6,-4" CornerRadius="14" Background="{StaticResource DashboardBedGradient}" BorderBrush="#9A05080D" BorderThickness="1" IsHitTestVisible="False" />
          <Border Grid.RowSpan="4" Margin="-5,-4,-5,-3" CornerRadius="13" BorderBrush="#244F5E6C" BorderThickness="1" IsHitTestVisible="False" />

          <Grid x:Name="CodexSection" Grid.Row="0" Tag="codex" CanDrag="True" DragStarting="Section_DragStarting" DropCompleted="Section_DropCompleted">
            <Border CornerRadius="16" Background="#D3020509" BorderBrush="#E1030508" BorderThickness="1" />
            <Border Margin="1,2,1,1" CornerRadius="15" Background="#8B000207" BorderBrush="#304B5966" BorderThickness="1" />
          <Border x:Name="CodexCard" Margin="2,3,2,2" Background="{StaticResource CardGradient}" BorderBrush="#5971838F" BorderThickness="1" CornerRadius="14" Padding="17,13">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE700;" FontSize="8" Foreground="#647E9D" /><TextBlock Text="CODEX" Style="{StaticResource EyebrowStyle}" /></StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="8" Background="#29365975" Padding="8,3" MaxWidth="145">
                  <TextBlock Text="{Binding CodexPlan}" Foreground="#9AAFC9" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" Margin="0,3,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="CodexValue" Text="{Binding CodexRemaining}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="CodexCaption" Text="REMAINING" Foreground="#647E9D" FontSize="8" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CodexWindowUsage}" Foreground="#B8CBE0" FontSize="10" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding CodexReset}" Foreground="#66809E" FontSize="9" Margin="0,2,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                  <Grid Margin="0,5,0,0">
                    <TextBlock Text="{Binding CodexSecondaryUsage}" Foreground="#A7C2DB" FontSize="9" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CodexSecondaryReset}" Foreground="#66809E" FontSize="9" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2" Height="8">
                <Border CornerRadius="4" Background="#E004070C" BorderBrush="#6D000000" BorderThickness="1" />
                <ProgressBar Height="4" Margin="2" Minimum="0" Maximum="100" Value="{Binding CodexUsedPercent}" Foreground="{StaticResource AccentGradient}" />
              </Grid>
            </Grid>
          </Border>
            <Border Margin="3,4,3,0" Height="1" VerticalAlignment="Top" Background="#38EDF7FF" CornerRadius="1" IsHitTestVisible="False" />
            <Border Margin="4" CornerRadius="12" IsHitTestVisible="False" Background="{StaticResource GlassReflectionGradient}" Opacity="0.34" />
          </Grid>

          <!-- Compute telemetry shares one physical row: GPU remains left, CPU is immediately readable at right. -->
          <Grid x:Name="SystemSection" Grid.Row="1" Tag="system" ColumnSpacing="8" CanDrag="True" DragStarting="Section_DragStarting" DropCompleted="Section_DropCompleted">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid>
              <Border CornerRadius="16" Background="#D3020509" BorderBrush="#E1030508" BorderThickness="1" />
              <Border Margin="1,2,1,1" CornerRadius="15" Background="#8B000207" BorderBrush="#304B5966" BorderThickness="1" />
              <Border x:Name="GpuCard" Margin="2,3,2,2" Background="{StaticResource CardGradient}" BorderBrush="#5971838F" BorderThickness="1" CornerRadius="14" Padding="13,12">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid x:Name="GpuSparklineHost" Grid.RowSpan="3" Height="32" VerticalAlignment="Bottom" Margin="0,0,0,7" IsHitTestVisible="False" />
                  <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE700;" FontSize="8" Foreground="#647E9D" /><TextBlock Text="GPU" Style="{StaticResource EyebrowStyle}" /></StackPanel>
                  <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GpuValue" Text="{Binding GpuUsage}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GpuMemory}" Foreground="#B9CEE4" FontSize="10" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding GpuThermals}" Foreground="#6F8BA7" FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Grid Grid.Row="2" Height="8"><Border CornerRadius="4" Background="#E004070C" BorderBrush="#6D000000" BorderThickness="1" /><ProgressBar Height="4" Margin="2" Minimum="0" Maximum="100" Value="{Binding GpuUsagePercent}" Foreground="{StaticResource AccentGradient}" /></Grid>
                </Grid>
              </Border>
              <Border Margin="3,4,3,0" Height="1" VerticalAlignment="Top" Background="#38EDF7FF" CornerRadius="1" IsHitTestVisible="False" />
              <Border Margin="4" CornerRadius="12" IsHitTestVisible="False" Background="{StaticResource GlassReflectionGradient}" Opacity="0.28" />
            </Grid>
            <Grid Grid.Column="1">
              <Border CornerRadius="16" Background="#D3020509" BorderBrush="#E1030508" BorderThickness="1" />
              <Border Margin="1,2,1,1" CornerRadius="15" Background="#8B000207" BorderBrush="#304B5966" BorderThickness="1" />
              <Border x:Name="CpuCard" Margin="2,3,2,2" Background="{StaticResource CardGradient}" BorderBrush="#5971838F" BorderThickness="1" CornerRadius="14" Padding="13,12">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE700;" FontSize="8" Foreground="#647E9D" /><TextBlock Text="SYSTEM" Style="{StaticResource EyebrowStyle}" /></StackPanel>
                  <Grid Grid.Row="1" VerticalAlignment="Center" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CPU" Foreground="#647E9D" FontSize="8" /><TextBlock x:Name="CpuValue" Text="{Binding CpuUsage}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="{Binding CpuDetails}" Foreground="#A7C2DB" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="RAM" Foreground="#647E9D" FontSize="8" /><TextBlock x:Name="RamValue" Text="{Binding RamUsage}" Foreground="#D9E8F7" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="{Binding RamDetails}" Foreground="#A7C2DB" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel>
                  </Grid>
                  <Grid Grid.Row="2" Height="8" ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid><Border CornerRadius="4" Background="#E004070C" BorderBrush="#6D000000" BorderThickness="1" /><ProgressBar Height="4" Margin="2" Minimum="0" Maximum="100" Value="{Binding CpuUsagePercent}" Foreground="{StaticResource AccentGradient}" /></Grid><Grid Grid.Column="1"><Border CornerRadius="4" Background="#E004070C" BorderBrush="#6D000000" BorderThickness="1" /><ProgressBar Height="4" Margin="2" Minimum="0" Maximum="100" Value="{Binding RamUsagePercent}" Foreground="{StaticResource AccentGradient}" /></Grid></Grid>
                </Grid>
              </Border>
              <Border Margin="3,4,3,0" Height="1" VerticalAlignment="Top" Background="#38EDF7FF" CornerRadius="1" IsHitTestVisible="False" />
              <Border Margin="4" CornerRadius="12" IsHitTestVisible="False" Background="{StaticResource GlassReflectionGradient}" Opacity="0.22" />
            </Grid>
          </Grid>

          <Grid x:Name="ModelsSection" Grid.Row="2" Tag="models" CanDrag="True" DragStarting="Section_DragStarting" DropCompleted="Section_DropCompleted">
            <Border CornerRadius="16" Background="#D3020509" BorderBrush="#E1030508" BorderThickness="1" />
            <Border Margin="1,2,1,1" CornerRadius="15" Background="#8B000207" BorderBrush="#304B5966" BorderThickness="1" />
          <Border x:Name="ModelCard" Margin="2,3,2,2" Background="{StaticResource CardGradient}" BorderBrush="#5971838F" BorderThickness="1" CornerRadius="14" Padding="17,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE700;" FontSize="8" Foreground="#647E9D" /><TextBlock Text="MODELS" Style="{StaticResource EyebrowStyle}" /></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding OllamaState}" Foreground="#49DFB5" FontSize="9" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid Grid.Row="1" Margin="0,3,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="ModelValue" Text="{Binding ModelCount}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActiveModelShort}" ToolTipService.ToolTip="{Binding ActiveModel}" Foreground="#D0E0F0" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Right" />
                  <TextBlock Text="{Binding ModelStorage}" Foreground="#647E9D" FontSize="9" Margin="0,5,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2"><Border Height="1" Background="#3B526475" /><Border Background="#D40B111A" BorderBrush="#323C4C5A" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right"><TextBlock Text="LOCAL ONLY" Foreground="#607E9B" FontSize="8" /></Border></Grid>
            </Grid>
          </Border>
            <Border Margin="3,4,3,0" Height="1" VerticalAlignment="Top" Background="#38EDF7FF" CornerRadius="1" IsHitTestVisible="False" />
            <Border Margin="4" CornerRadius="12" IsHitTestVisible="False" Background="{StaticResource GlassReflectionGradient}" Opacity="0.24" />
          </Grid>

          <Border x:Name="DragInsertionIndicator" Grid.ColumnSpan="2" Height="3" Margin="10,-6" VerticalAlignment="Top" CornerRadius="2" Background="{StaticResource AccentGradient}" Opacity="0" IsHitTestVisible="False" Canvas.ZIndex="20">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
          </Border>

          <Grid Grid.Row="3" Margin="5,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="5" Height="5" Fill="#35F2B4" Margin="0,0,7,0" />
              <TextBlock Text="{Binding SystemState}" Foreground="#7189A6" FontSize="8" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding LastRefreshText}" Foreground="#536E8D" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Grid>

        <Grid x:Name="ConversationPanel" Grid.Row="1" Margin="16,2,16,14" Visibility="Collapsed" RowSpacing="9">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border CornerRadius="12" Background="#7A071019" BorderBrush="#485F7A94" BorderThickness="1" Padding="12,8">
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="#FF5A7A" VerticalAlignment="Center" />
                <TextBlock Text="MICROPHONE ACTIVE" Foreground="#FF8EA5" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Status}" Foreground="#8DB0CF" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="MODEL" Style="{StaticResource EyebrowStyle}" /><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" SelectionChanged="ModelSelection_Changed" FontSize="10" HorizontalAlignment="Stretch" MaxDropDownHeight="420" ToolTipService.ToolTip="{Binding SelectedModel}" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="CONTEXT" Style="{StaticResource EyebrowStyle}" /><ComboBox ItemsSource="{Binding ContextChoices}" SelectedItem="{Binding Context, Mode=TwoWay}" SelectionChanged="ContextSelection_Changed" FontSize="10" HorizontalAlignment="Stretch" /></StackPanel>
          </Grid>
          <Border Grid.Row="2" CornerRadius="12" Background="#8A05090F" BorderBrush="#364F6478" BorderThickness="1" Padding="10">
            <ListView x:Name="TranscriptList" ItemsSource="{Binding Transcript}" Background="Transparent" BorderThickness="0" SelectionMode="None">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4,0,8">
                    <TextBlock Text="{Binding Role}" Foreground="#6F8EAB" FontSize="8" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Text}" Foreground="#E0ECF8" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Border>
          <TextBlock Grid.Row="3" Text="{Binding PartialTranscript}" Foreground="#7998B6" FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis" />
          <Grid Grid.Row="4" RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="VOICE" Style="{StaticResource EyebrowStyle}" /><ComboBox ItemsSource="{Binding Voices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedVoice, Mode=TwoWay}" SelectionChanged="VoiceSelection_Changed" FontSize="10" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="PROFILE" Style="{StaticResource EyebrowStyle}" /><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" SelectionChanged="ProfileSelection_Changed" FontSize="10" /></StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
              <Button Content="RETRY" Style="{StaticResource MenuActionButtonStyle}" Padding="10,0" Click="RetryVoiceButton_Click" />
              <Button Content="START SERVER" Style="{StaticResource MenuActionButtonStyle}" Padding="10,0" Click="StartVoiceServerButton_Click" />
              <Button x:Name="MuteVoiceButton" Content="MUTE" Style="{StaticResource MenuActionButtonStyle}" Padding="10,0" Click="MuteVoiceButton_Click" />
              <Button Content="STOP" Style="{StaticResource MenuActionButtonStyle}" Padding="10,0" Click="StopResponseButton_Click" />
              <Button Content="END" Style="{StaticResource MenuActionButtonStyle}" Padding="10,0" Click="EndConversationButton_Click" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Dashboard.Margin" Value="10,0,10,9" />
            <Setter Target="Dashboard.RowSpacing" Value="6" />
            <Setter Target="CodexValue.FontSize" Value="28" />
            <Setter Target="GpuValue.FontSize" Value="26" />
            <Setter Target="CpuValue.FontSize" Value="26" />
            <Setter Target="RamValue.FontSize" Value="26" />
            <Setter Target="ModelValue.FontSize" Value="24" />
            <Setter Target="CodexCaption.Visibility" Value="Collapsed" />
            <Setter Target="HeaderSubtitle.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Standard">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="400" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Dashboard.Margin" Value="16,2,16,14" />
            <Setter Target="Dashboard.RowSpacing" Value="10" />
            <Setter Target="CodexValue.FontSize" Value="34" />
            <Setter Target="GpuValue.FontSize" Value="31" />
            <Setter Target="CpuValue.FontSize" Value="31" />
            <Setter Target="RamValue.FontSize" Value="31" />
            <Setter Target="ModelValue.FontSize" Value="29" />
            <Setter Target="CodexCaption.Visibility" Value="Visible" />
            <Setter Target="HeaderSubtitle.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="ShortWindow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowHeight="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="CodexCard.Padding" Value="12,8" />
            <Setter Target="GpuCard.Padding" Value="10,8" />
            <Setter Target="CpuCard.Padding" Value="10,8" />
            <Setter Target="ModelCard.Padding" Value="12,7" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TallWindow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowHeight="510" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="CodexCard.Padding" Value="17,13" />
            <Setter Target="GpuCard.Padding" Value="13,12" />
            <Setter Target="CpuCard.Padding" Value="13,12" />
            <Setter Target="ModelCard.Padding" Value="17,12" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Window>
