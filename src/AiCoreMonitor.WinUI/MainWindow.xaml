<Window
    x:Class="AiCoreMonitor.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2ADFFF" Offset="0" />
        <GradientStop Color="#7388FF" Offset="0.52" />
        <GradientStop Color="#C15CFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#541C2B43" Offset="0" />
        <GradientStop Color="#30101829" Offset="0.72" />
        <GradientStop Color="#40211937" Offset="1" />
      </LinearGradientBrush>
      <Style x:Key="EyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#8299B8" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Foreground" Value="#B4C7DD" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
    </Grid.Resources>

    <Grid x:Name="LavaHost" IsHitTestVisible="False" />

    <Border Margin="1" CornerRadius="20" Background="#24101828" BorderBrush="#A27E9AC0" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" CornerRadius="19" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#1FDDF6FF" Offset="0" />
              <GradientStop Color="#08EAF8FF" Offset="0.16" />
              <GradientStop Color="#00000000" Offset="0.42" />
              <GradientStop Color="#081E7CFF" Offset="0.76" />
              <GradientStop Color="#20B75CFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border Grid.RowSpan="2" Margin="2" CornerRadius="18" BorderThickness="1" BorderBrush="#2FFFFFFF" IsHitTestVisible="False" />

        <Grid x:Name="DragRegion" Grid.Row="0" Margin="17,0,9,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="18" Height="18" Margin="0,0,10,0">
              <Ellipse Width="16" Height="16" Fill="#3635F2B4" />
              <Ellipse Width="7" Height="7" Fill="#35F2B4" />
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="AI / CORE" Foreground="#E3F0FF" FontSize="12" FontWeight="Bold" />
              <TextBlock x:Name="HeaderSubtitle" Text="WORKSTATION INTELLIGENCE" Foreground="#597391" FontSize="8" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="HeaderActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="AnimationButton" Style="{StaticResource HeaderButtonStyle}" Content="FX" FontSize="9">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" Opened="EffectsFlyout_Opened">
                  <Border Width="176" Padding="9,6" CornerRadius="9" Background="#F21A1428">
                    <Grid RowSpacing="3" ColumnSpacing="6">
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                      <TextBlock Text="LAVA" Foreground="#B4C7DD" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Slider x:Name="LavaAmountSlider" Grid.Column="1" Minimum="10" Maximum="100" />
                      <ToggleSwitch x:Name="LavaToggle" Grid.Column="2" Width="40" MinWidth="40" OnContent="" OffContent="" />
                      <TextBlock Grid.Row="1" Text="CRACK" Foreground="#B4C7DD" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Slider x:Name="CrackAmountSlider" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="100" />
                      <ToggleSwitch x:Name="CracksToggle" Grid.Row="1" Grid.Column="2" Width="40" MinWidth="40" OnContent="" OffContent="" />
                    </Grid>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Style="{StaticResource HeaderButtonStyle}" Content="—" FontSize="12" Click="MinimizeButton_Click" />
            <Button Style="{StaticResource HeaderButtonStyle}" Content="×" FontSize="16" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Grid x:Name="Dashboard" Grid.Row="1" Margin="16,2,16,14" RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.08*" />
            <RowDefinition Height="1.08*" />
            <RowDefinition Height="0.95*" />
            <RowDefinition Height="24" />
          </Grid.RowDefinitions>

          <Border x:Name="CodexCard" Grid.Row="0" Background="{StaticResource CardGradient}" BorderBrush="#405A7498" BorderThickness="1" CornerRadius="16" Padding="17,13">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="CODEX ALLOCATION" Style="{StaticResource EyebrowStyle}" />
                <Border Grid.Column="1" HorizontalAlignment="Right" CornerRadius="8" Background="#29365975" Padding="8,3" MaxWidth="145">
                  <TextBlock Text="{Binding CodexPlan}" Foreground="#9AAFC9" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
              </Grid>
              <Grid Grid.Row="1" Margin="0,3,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="CodexValue" Text="{Binding CodexRemaining}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="CodexCaption" Text="ALLOCATION REMAINING" Foreground="#647E9D" FontSize="8" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CodexReset}" Foreground="#B8CBE0" FontSize="10" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding CodexTokens}" Foreground="#66809E" FontSize="9" Margin="0,6,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
              <ProgressBar Grid.Row="2" Height="5" Minimum="0" Maximum="100" Value="{Binding CodexUsedPercent}" Foreground="{StaticResource AccentGradient}" />
            </Grid>
          </Border>

          <Border x:Name="GpuCard" Grid.Row="1" Background="{StaticResource CardGradient}" BorderBrush="#405A7498" BorderThickness="1" CornerRadius="16" Padding="17,13">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid x:Name="GpuSparklineHost" Grid.RowSpan="3" Height="48" VerticalAlignment="Bottom" Margin="0,0,0,7" IsHitTestVisible="False" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="GPU COMPUTE" Style="{StaticResource EyebrowStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding GpuName}" Foreground="#66809E" FontSize="9" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid Grid.Row="1" Margin="0,3,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="GpuValue" Text="{Binding GpuUsage}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="31" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="GpuCaption" Text="GPU LOAD" Foreground="#647E9D" FontSize="8" Margin="2,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <TextBlock Text="{Binding GpuMemory}" Foreground="#CFDEED" FontSize="13" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="VRAM IN USE" Foreground="#647E9D" FontSize="8" TextAlignment="Right" />
                  <TextBlock Text="{Binding GpuThermals}" Foreground="#8097B3" FontSize="10" Margin="0,5,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
              <ProgressBar Grid.Row="2" Height="5" Minimum="0" Maximum="100" Value="{Binding GpuUsagePercent}" Foreground="{StaticResource AccentGradient}" />
            </Grid>
          </Border>

          <Border x:Name="ModelCard" Grid.Row="2" Background="{StaticResource CardGradient}" BorderBrush="#405A7498" BorderThickness="1" CornerRadius="16" Padding="17,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="LOCAL MODEL VAULT" Style="{StaticResource EyebrowStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding OllamaState}" Foreground="#49DFB5" FontSize="9" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid Grid.Row="1" Margin="0,3,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="ModelValue" Text="{Binding ModelCount}" Foreground="#F2F8FF" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="ModelCaption" Text="{Binding ModelCountLabel}" Foreground="#647E9D" FontSize="8" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ActiveModelShort}" ToolTipService.ToolTip="{Binding ActiveModel}" Foreground="#D0E0F0" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Right" />
                  <TextBlock Text="{Binding ModelStorage}" Foreground="#647E9D" FontSize="9" Margin="0,5,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2"><Border Height="1" Background="#33445D79" /><Border Background="#121A2A" Padding="6,0" HorizontalAlignment="Right"><TextBlock Text="LOCALHOST / PRIVATE" Foreground="#4D6987" FontSize="8" /></Border></Grid>
            </Grid>
          </Border>

          <Grid Grid.Row="3" Margin="3,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="5" Height="5" Fill="#35F2B4" Margin="0,0,7,0" />
              <TextBlock Text="{Binding SystemState}" Foreground="#7189A6" FontSize="8" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding LastRefreshText}" Foreground="#536E8D" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Dashboard.Margin" Value="10,0,10,9" />
            <Setter Target="Dashboard.RowSpacing" Value="6" />
            <Setter Target="CodexValue.FontSize" Value="28" />
            <Setter Target="GpuValue.FontSize" Value="26" />
            <Setter Target="ModelValue.FontSize" Value="24" />
            <Setter Target="CodexCaption.Visibility" Value="Collapsed" />
            <Setter Target="GpuCaption.Visibility" Value="Collapsed" />
            <Setter Target="ModelCaption.Visibility" Value="Collapsed" />
            <Setter Target="HeaderSubtitle.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Standard">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="400" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Dashboard.Margin" Value="16,2,16,14" />
            <Setter Target="Dashboard.RowSpacing" Value="10" />
            <Setter Target="CodexValue.FontSize" Value="34" />
            <Setter Target="GpuValue.FontSize" Value="31" />
            <Setter Target="ModelValue.FontSize" Value="29" />
            <Setter Target="CodexCaption.Visibility" Value="Visible" />
            <Setter Target="GpuCaption.Visibility" Value="Visible" />
            <Setter Target="ModelCaption.Visibility" Value="Visible" />
            <Setter Target="HeaderSubtitle.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="ShortWindow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowHeight="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="CodexCard.Padding" Value="12,8" />
            <Setter Target="GpuCard.Padding" Value="12,8" />
            <Setter Target="ModelCard.Padding" Value="12,7" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="TallWindow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowHeight="510" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="CodexCard.Padding" Value="17,13" />
            <Setter Target="GpuCard.Padding" Value="17,13" />
            <Setter Target="ModelCard.Padding" Value="17,12" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Window>
